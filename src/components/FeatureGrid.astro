---
const features = [
  {
    icon: 'feed',
    title: 'Live Feed',
    copy: 'Real-time incidents the moment they hit dispatch. Fire, traffic, weather, crime — filtered by what matters to you.',
  },
  {
    icon: 'map',
    title: 'Incident Map',
    copy: 'Every active event on a live map. Tap any pin for full dispatch notes, community photos, and push alerts.',
  },
  {
    icon: 'camera',
    title: 'Community Submit',
    copy: 'Spot something? Submit a photo. AI captions, location tagging, and moderation — you\'re on the wire in seconds.',
  },
  {
    icon: 'bell',
    title: 'Smart Alerts',
    copy: 'Radius-based push for the incident types you care about. You set the distance; we handle the rest.',
  },
  {
    icon: 'trophy',
    title: 'Contributor Rewards',
    copy: 'Points, streak badges, and sponsor-funded giveaways for the community keeping the wire hot.',
  },
  {
    icon: 'globe',
    title: 'Growing Cities',
    copy: 'Spokane first. Boise, Tacoma, and Tri-Cities next. One app, every city we launch.',
  },
] as const;
---

<section class="features">
  <div class="features-inner">
    <p class="section-eyebrow">WHAT WIRE LOCAL DOES</p>
    <h2 class="section-heading">Everything happening,<br />right now.</h2>

    <div class="grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="icon-wrap" aria-hidden="true">
            {f.icon === 'feed' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 6h16M4 10h16M4 14h10M4 18h8"/>
              </svg>
            )}
            {f.icon === 'map' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
                <line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
              </svg>
            )}
            {f.icon === 'camera' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
            )}
            {f.icon === 'bell' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
              </svg>
            )}
            {f.icon === 'trophy' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="8 21 12 17 16 21"/><path d="M17 1H7l-4 6h18l-4-6z"/>
                <path d="M7 7C7 13 17 13 17 7"/><line x1="12" y1="17" x2="12" y2="13"/>
              </svg>
            )}
            {f.icon === 'globe' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            )}
          </div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-copy">{f.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 96px var(--sw-s-4);
    background: var(--sw-surface-card);
    border-top: 1px solid var(--sw-border);
  }

  .features-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-eyebrow {
    font-family: var(--sw-font-mono);
    font-size: var(--sw-fs-11);
    font-weight: 500;
    letter-spacing: var(--sw-track-wide);
    text-transform: uppercase;
    color: var(--sw-ink-muted);
    margin-bottom: var(--sw-s-4);
  }

  .section-heading {
    font-family: var(--sw-font-sans);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: var(--sw-track-snug);
    color: var(--sw-ink);
    margin-bottom: 56px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--sw-border);
    border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-lg);
    overflow: hidden;
  }

  .feature-card {
    background: var(--sw-bg);
    padding: var(--sw-s-8) var(--sw-s-6);
    display: flex;
    flex-direction: column;
    gap: var(--sw-s-3);
  }

  .icon-wrap {
    color: var(--sw-sw-red, #ef4444);
    color: var(--sw-red);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(239,68,68,0.1);
    border-radius: var(--sw-radius-sm);
    margin-bottom: 4px;
  }

  .feature-title {
    font-family: var(--sw-font-sans);
    font-weight: 700;
    font-size: var(--sw-fs-16);
    line-height: 1.2;
    color: var(--sw-ink);
  }

  .feature-copy {
    font-size: var(--sw-fs-14);
    line-height: 1.55;
    color: var(--sw-ink-muted);
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .grid { grid-template-columns: 1fr; }
    .features { padding: 64px var(--sw-s-4); }
  }
</style>
