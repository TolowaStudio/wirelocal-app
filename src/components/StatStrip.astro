<div class="stat-strip">
  <div class="stat-strip-inner">
    <span class="stat">SPOKANE · LIVE</span>
    <span class="sep" aria-hidden="true">·</span>
    <span class="stat">BOISE · COMING SOON</span>
    <span class="sep" aria-hidden="true">·</span>
    <span class="stat">TACOMA · COMING SOON</span>
    <span class="sep" aria-hidden="true">·</span>
    <span class="stat">COMMUNITY-POWERED</span>
    <span class="sep" aria-hidden="true">·</span>
    <span class="stat">24 / 7</span>
  </div>
</div>

<style>
  .stat-strip {
    border-top: 1px solid var(--sw-border);
    border-bottom: 1px solid var(--sw-border);
    background: var(--sw-surface-card);
    padding: 14px var(--sw-s-4);
    overflow: hidden;
  }

  .stat-strip-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .stat {
    font-family: var(--sw-font-mono);
    font-size: var(--sw-fs-11);
    font-weight: 500;
    letter-spacing: var(--sw-track-wide);
    text-transform: uppercase;
    color: var(--sw-ink-muted);
    white-space: nowrap;
  }

  .sep {
    color: var(--sw-border-strong);
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .sep { display: none; }
    .stat-strip-inner { gap: 8px; }
  }
</style>
