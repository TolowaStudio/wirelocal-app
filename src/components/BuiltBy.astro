---
---

<section class="built-by">
  <div class="built-by-inner">
    <div class="divider" aria-hidden="true"></div>

    <div class="content">
      <p class="eyebrow">BUILT BY</p>
      <a href="https://tolowastudio.com" target="_blank" rel="noopener noreferrer" class="studio-link">
        <span class="studio-name">Tolowa Studio</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
      <p class="studio-desc">
        Tolowa Studio builds civic tech products for communities across the Pacific Northwest. Wire Local is the flagship.
      </p>
    </div>
  </div>
</section>

<style>
  .built-by {
    padding: 80px var(--sw-s-4);
  }

  .built-by-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .divider {
    width: 40px;
    height: 1px;
    background: var(--sw-red);
    margin-bottom: 40px;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--sw-s-3);
    max-width: 480px;
  }

  .eyebrow {
    font-family: var(--sw-font-mono);
    font-size: var(--sw-fs-11);
    font-weight: 500;
    letter-spacing: var(--sw-track-wide);
    text-transform: uppercase;
    color: var(--sw-ink-muted);
  }

  .studio-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--sw-font-sans);
    font-weight: 800;
    font-size: var(--sw-fs-28);
    letter-spacing: var(--sw-track-snug);
    color: var(--sw-ink);
    transition: color var(--sw-dur-fast) var(--sw-ease-out);
  }

  .studio-link:hover { color: var(--sw-red); }

  .studio-desc {
    font-size: var(--sw-fs-15);
    line-height: 1.6;
    color: var(--sw-ink-muted);
  }
</style>
