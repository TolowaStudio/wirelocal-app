---
import AppBadges from './AppBadges.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-wordmark">
          <b>wire</b><i>local</i>
        </div>
        <p class="footer-tagline">Your city, live.</p>
        <AppBadges />
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-nav-group">
          <p class="footer-nav-label">Product</p>
          <a href="https://spokanewire.com" target="_blank" rel="noopener noreferrer">SpokaneWire</a>
          <a href="#cities">Cities</a>
          <a href="#features">Features</a>
        </div>
        <div class="footer-nav-group">
          <p class="footer-nav-label">Company</p>
          <a href="https://tolowastudio.com" target="_blank" rel="noopener noreferrer">Tolowa Studio</a>
          <a href="mailto:hello@wirelocal.app">Contact</a>
        </div>
        <div class="footer-nav-group">
          <p class="footer-nav-label">Legal</p>
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-legal">
        &copy; {year} Tolowa Pacific LLC. Wire Local is a product of Tolowa Studio.
      </p>
      <p class="footer-mono">COMMUNITY-POWERED &middot; CIVIC FIRST</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--sw-border);
    background: var(--sw-surface-card);
    padding: 64px var(--sw-s-4) 40px;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 64px;
    margin-bottom: 56px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--sw-s-4);
  }

  .footer-wordmark {
    font-family: var(--sw-font-sans);
    font-size: 22px;
    line-height: 0.9;
    letter-spacing: -0.025em;
    display: inline-flex;
    align-items: baseline;
    gap: 0;
    text-transform: lowercase;
  }
  .footer-wordmark b { font-weight: 800; color: var(--sw-ink); }
  .footer-wordmark i { font-weight: 300; font-style: normal; color: var(--sw-ink-muted); }

  .footer-tagline {
    font-size: var(--sw-fs-13);
    color: var(--sw-ink-faint);
    margin-top: -4px;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sw-s-8);
  }

  .footer-nav-group {
    display: flex;
    flex-direction: column;
    gap: var(--sw-s-3);
  }

  .footer-nav-label {
    font-family: var(--sw-font-mono);
    font-size: var(--sw-fs-11);
    font-weight: 500;
    letter-spacing: var(--sw-track-wide);
    text-transform: uppercase;
    color: var(--sw-ink-faint);
    margin-bottom: 4px;
  }

  .footer-nav-group a {
    font-size: var(--sw-fs-14);
    color: var(--sw-ink-muted);
    transition: color var(--sw-dur-fast) var(--sw-ease-out);
  }

  .footer-nav-group a:hover { color: var(--sw-ink); }

  .footer-bottom {
    border-top: 1px solid var(--sw-border);
    padding-top: var(--sw-s-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sw-s-4);
    flex-wrap: wrap;
  }

  .footer-legal {
    font-size: var(--sw-fs-12);
    color: var(--sw-ink-faint);
  }

  .footer-mono {
    font-family: var(--sw-font-mono);
    font-size: var(--sw-fs-11);
    font-weight: 500;
    letter-spacing: var(--sw-track-wide);
    text-transform: uppercase;
    color: var(--sw-ink-disabled);
  }

  @media (max-width: 800px) {
    .footer-top { grid-template-columns: 1fr; gap: 40px; }
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .footer-nav { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
