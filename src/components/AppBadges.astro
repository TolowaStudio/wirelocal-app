---
export interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<div class:list={['badges', cls]}>
  <!-- App Store -->
  <a href="#" class="badge-link" aria-label="Download on the App Store">
    <svg class="badge-svg" viewBox="0 0 135 40" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <rect width="135" height="40" rx="7" fill="#1a1d27" stroke="#2a2f40"/>
      <text x="38" y="14" fill="#94a3b8" font-family="Inter,sans-serif" font-size="8" font-weight="500" letter-spacing="0.05em">DOWNLOAD ON THE</text>
      <text x="37" y="29" fill="#f1f5f9" font-family="Inter,sans-serif" font-size="16" font-weight="700">App Store</text>
      <!-- Apple logo path approximation -->
      <path d="M16 12.5c1.2-1.5 2-3.5 1.8-5.5-1.8.1-3.9 1.2-5.1 2.7-1.1 1.3-2.1 3.4-1.7 5.4 2 .1 4-1.1 5-2.6zm4.2 11.5c0-3.5 2.9-5.1 3-5.2-1.6-2.4-4.2-2.7-5.1-2.7-2.2-.2-4.3 1.3-5.4 1.3-1.1 0-2.8-1.2-4.6-1.2-2.4.1-4.6 1.4-5.8 3.5-2.5 4.3-.6 10.6 1.8 14.1 1.2 1.7 2.6 3.7 4.4 3.6 1.8-.1 2.4-1.1 4.6-1.1 2.1 0 2.7 1.1 4.6 1.1 1.9 0 3.1-1.8 4.3-3.5.6-.9 1-1.9 1.3-3-.1 0-3.1-1.2-3.1-4.9z" fill="#f1f5f9" transform="translate(6, 8) scale(0.55)"/>
    </svg>
  </a>

  <!-- Google Play -->
  <a href="#" class="badge-link" aria-label="Get it on Google Play">
    <svg class="badge-svg" viewBox="0 0 135 40" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <rect width="135" height="40" rx="7" fill="#1a1d27" stroke="#2a2f40"/>
      <text x="38" y="14" fill="#94a3b8" font-family="Inter,sans-serif" font-size="8" font-weight="500" letter-spacing="0.05em">GET IT ON</text>
      <text x="37" y="29" fill="#f1f5f9" font-family="Inter,sans-serif" font-size="16" font-weight="700">Google Play</text>
      <!-- Play triangle -->
      <polygon points="10,10 10,30 28,20" fill="#34d399" transform="translate(3, 0) scale(0.75)"/>
    </svg>
  </a>
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .badge-link {
    display: inline-flex;
    transition: opacity var(--sw-dur-fast) var(--sw-ease-out), transform var(--sw-dur-fast) var(--sw-ease-out);
  }

  .badge-link:hover { opacity: 0.8; transform: translateY(-1px); }
  .badge-link:active { opacity: 1; transform: scale(0.97); }

  .badge-svg {
    width: 135px;
    height: 40px;
  }
</style>
