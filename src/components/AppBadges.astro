---
export interface Props {
  class?: string;
}
const { class: cls } = Astro.props;

// Store URLs stay empty until the apps are published.
export const APP_STORE_URL = '';
export const GOOGLE_PLAY_URL = '';
---

<div class:list={['badges', cls]}>
  <p class="coming-soon">Coming soon to iOS and Android</p>
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .coming-soon {
    margin: 0;
    color: var(--sw-ink-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }
</style>
