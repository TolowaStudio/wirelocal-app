---
import AppBadges from './AppBadges.astro';
import MockFeedCard from './MockFeedCard.astro';
---

<section class="hero">
  <!-- Background pulse glow -->
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="sw-live-dot" />
        <span>LIVE WIRE &middot; CIVIC ALERTS &middot; YOUR CITY</span>
      </p>

      <h1 class="display">
        Your city,<br />live.
      </h1>

      <p class="sub">
        Wire Local delivers real-time incidents, community tips, and breaking local news — wherever you are.
      </p>

      <AppBadges class="hero-badges" />

      <p class="coming-soon-note">Coming soon to iOS &amp; Android</p>
    </div>

    <div class="hero-preview" aria-hidden="true">
      <div class="phone-frame">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <!-- Top bar -->
          <div class="app-topbar">
            <div class="app-wordmark">
              <b>spokane</b><i>wire</i>
            </div>
            <div class="topbar-right">
              <span class="sw-live-dot" style="width:6px;height:6px;" />
              <span class="live-label">LIVE</span>
            </div>
          </div>

          <!-- Ticker -->
          <div class="app-ticker">
            <span class="ticker-pill">LIVE WIRE</span>
            <span class="ticker-text">Structure fire E Sprague Ave · SPD pursuit ended N Division · NWS Wind Advisory in effect</span>
          </div>

          <!-- Feed cards -->
          <div class="app-feed">
            <MockFeedCard
              type="fire"
              severity="critical"
              title="Structure fire · 2 units responding"
              address="E Sprague Ave &amp; N Helena St"
              source="SFD DISPATCH"
              time="2m"
              isLive={true}
            />
            <MockFeedCard
              type="traffic"
              severity="high"
              title="Multi-vehicle collision · right lane blocked"
              address="I-90 WB near Exit 281"
              source="WSDOT"
              time="9m"
            />
            <MockFeedCard
              type="crime"
              severity="medium"
              title="Pursuit ended · suspect in custody"
              address="N Division St &amp; E Francis Ave"
              source="SPD DISPATCH"
              time="14m"
              status="resolved"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 80px var(--sw-s-4) 60px;
  }

  .hero-glow {
    position: absolute;
    top: -200px;
    left: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(239,68,68,0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  /* ---- copy ---- */
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--sw-s-6);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sw-s-2);
    font-family: var(--sw-font-mono);
    font-size: var(--sw-fs-11);
    font-weight: 500;
    letter-spacing: var(--sw-track-wide);
    text-transform: uppercase;
    color: var(--sw-ink-muted);
  }

  .display {
    font-family: var(--sw-font-sans);
    font-weight: 800;
    font-size: clamp(48px, 7vw, 80px);
    line-height: 1.0;
    letter-spacing: var(--sw-track-tight);
    color: var(--sw-ink);
  }

  .sub {
    font-size: var(--sw-fs-18);
    line-height: 1.5;
    color: var(--sw-ink-muted);
    max-width: 460px;
  }

  .hero-badges { margin-top: -8px; }

  .coming-soon-note {
    font-size: var(--sw-fs-12);
    color: var(--sw-ink-faint);
    letter-spacing: 0.02em;
    margin-top: -8px;
  }

  /* ---- phone mock ---- */
  .hero-preview {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .phone-frame {
    width: 260px;
    background: #07090d;
    border-radius: 36px;
    border: 1.5px solid var(--sw-border-strong);
    box-shadow: var(--sw-shadow-lg), 0 0 0 1px rgba(255,255,255,0.05);
    overflow: hidden;
    position: relative;
  }

  .phone-notch {
    width: 90px;
    height: 24px;
    background: #07090d;
    border-radius: 0 0 16px 16px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .phone-screen {
    padding: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .app-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 8px;
    background: rgba(11,13,18,0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .app-wordmark {
    font-family: var(--sw-font-sans);
    font-size: 15px;
    line-height: 0.9;
    letter-spacing: -0.025em;
    display: flex;
    align-items: baseline;
    gap: 0;
    text-transform: lowercase;
  }
  .app-wordmark b { font-weight: 800; color: var(--sw-ink); }
  .app-wordmark i { font-weight: 300; font-style: normal; color: var(--sw-ink-muted); }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .live-label {
    font-family: var(--sw-font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--sw-live);
    text-transform: uppercase;
  }

  .app-ticker {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--sw-surface-card);
    border-bottom: 1px solid var(--sw-border);
    padding: 7px 10px;
    overflow: hidden;
  }

  .ticker-pill {
    background: var(--sw-live);
    color: white;
    font-family: var(--sw-font-sans);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 9999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ticker-text {
    font-family: var(--sw-font-sans);
    font-size: 10px;
    font-weight: 500;
    color: var(--sw-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .app-feed {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px 10px;
  }

  /* Override card sizing inside phone mock */
  .app-feed :global(.card) {
    padding: 10px;
    gap: 5px;
  }
  .app-feed :global(.card-title) { font-size: 12px; }
  .app-feed :global(.card-address) { font-size: 10px; }
  .app-feed :global(.type-badge),
  .app-feed :global(.sev-badge),
  .app-feed :global(.live-pill),
  .app-feed :global(.source-badge),
  .app-feed :global(.resolved-badge) { font-size: 9px; padding: 1px 5px; }
  .app-feed :global(.mono-time) { font-size: 9px; }

  /* ---- responsive ---- */
  @media (max-width: 800px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-preview { display: none; }
    .sub { max-width: 100%; }
  }
</style>
